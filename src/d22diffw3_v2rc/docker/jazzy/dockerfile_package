### Install Gazebo-Vacuum-Gripper-Plugin
RUN echo 'Install Gazebo-Vacuum-Gripper-Plugin...'
WORKDIR $PATH_TO_GIT_SUBMODULES_NOT_ROS_PACKAGES/Gazebo-Vacuum-Gripper-Plugin/
RUN mkdir build && cd build && cmake .. && make
ENV GZ_SIM_SYSTEM_PLUGIN_PATH=$GZ_SIM_SYSTEM_PLUGIN_PATH::${PATH_TO_GIT_SUBMODULES_NOT_ROS_PACKAGES}/Gazebo-Vacuum-Gripper-Plugin/build
WORKDIR $PATH_TO_WS
### End install Gazebo-Vacuum-Gripper-Plugin

RUN sudo chmod +x /entrypoint_basic.bash
ENTRYPOINT ["/entrypoint_basic.bash"]
CMD ["bash"]
