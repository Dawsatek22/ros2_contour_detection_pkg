<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


<gazebo reference="l_cam001">
	<sensor type="thermal_camera" name="thermal_camera">
		<camera>
			<horizontal_fov>1.047</horizontal_fov>
			<image>
				<width>320</width>
				<height>240</height>
			</image>
			<clip>
				<near>0.1</near>
				<far>100.0</far>
			</clip>
			<save enabled="false">
				<path>/tmp/camera_thermal_data</path>
			</save>
			<triggered>false</triggered>
			<trigger_topic>camera_thermal/trigger</trigger_topic>
		</camera>
		<always_on>true</always_on>
		<update_rate>30.0</update_rate>
		<visualize>true</visualize>
		<topic>camera_thermal</topic>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

<gazebo reference="l_cam001">
	<sensor type="camera" name="camera">
		<camera>
			<horizontal_fov>1.047</horizontal_fov>
			<image>
				<width>320</width>
				<height>240</height>
			</image>
			<clip>
				<near>0.1</near>
				<far>100.0</far>
			</clip>
			<save enabled="false">
				<path>/tmp/camera_data</path>
			</save>
			<triggered>false</triggered>
			<trigger_topic>camera/trigger</trigger_topic>
		</camera>
		<always_on>true</always_on>
		<update_rate>30.0</update_rate>
		<visualize>true</visualize>
		<topic>camera</topic>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

<gazebo reference="l_cam001">
	<sensor type="imu" name="imu">
		<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>
		<always_on>true</always_on>
		<update_rate>100.0</update_rate>
		<visualize>true</visualize>
		<topic>imu</topic>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

<gazebo reference="l_cam001">
	<sensor type="boundingbox_camera" name="boundingbox_camera_visible_2d">
		<topic>camera_boxes_visible_2d</topic>
		<camera>
			<box_type>visible_2d</box_type>
			<horizontal_fov>1.047</horizontal_fov>
			<image>
				<width>800</width>
				<height>600</height>
			</image>
			<clip>
				<near>0.1</near>
				<far>10.0</far>
			</clip>
			<save enabled="false">
				<path>/tmp/camera_boxes_visible_2d_data</path>
			</save>
			<triggered>false</triggered>
			<trigger_topic>camera_boxes_visible_2d/trigger</trigger_topic>
		</camera>
		<always_on>true</always_on>
		<update_rate>30.0</update_rate>
		<visualize>true</visualize>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

<gazebo reference="l_cam001">
	<sensor type="boundingbox_camera" name="boundingbox_camera_visible_2d001">
		<topic>camera_boxes_visible_2d</topic>
		<camera>
			<box_type>visible_2d</box_type>
			<horizontal_fov>1.047</horizontal_fov>
			<image>
				<width>800</width>
				<height>600</height>
			</image>
			<clip>
				<near>0.1</near>
				<far>10.0</far>
			</clip>
			<save enabled="false">
				<path>/tmp/camera_boxes_visible_2d_data</path>
			</save>
			<triggered>false</triggered>
			<trigger_topic>camera_boxes_visible_2d/trigger</trigger_topic>
		</camera>
		<always_on>true</always_on>
		<update_rate>30.0</update_rate>
		<visualize>true</visualize>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

<gazebo reference="l_cam001">
	<sensor type="wideanglecamera" name="wideangle_camera">
		<camera>
			<horizontal_fov>3.14</horizontal_fov>
			<image>
				<width>800</width>
				<height>600</height>
			</image>
			<clip>
				<near>0.1</near>
				<far>100.0</far>
			</clip>
			<lens>
				<type>custom</type>
				<custom_function>
					<c1>1.05</c1>
					<c2>4.0</c2>
					<f>1.0</f>
					<fun>tan</fun>
				</custom_function>
				<scale_to_hfov>true</scale_to_hfov>
				<cutoff_angle>3.1415</cutoff_angle>
				<env_texture_size>512</env_texture_size>
			</lens>
			<save enabled="false">
				<path>/tmp/camera_wide_angle_data</path>
			</save>
			<triggered>false</triggered>
			<trigger_topic>camera_wide_angle/trigger</trigger_topic>
		</camera>
		<always_on>true</always_on>
		<update_rate>30.0</update_rate>
		<topic>camera_wide_angle</topic>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

<gazebo reference="l_cam001">
	<sensor type="depth_camera" name="depth_camera">
		<camera>
			<horizontal_fov>1.05</horizontal_fov>
			<image>
				<width>640</width>
				<height>480</height>
				<format>R_FLOAT32</format>
			</image>
			<clip>
				<near>0.1</near>
				<far>10.0</far>
			</clip>
			<save enabled="false">
				<path>/tmp/camera_depth_data</path>
			</save>
			<triggered>false</triggered>
			<trigger_topic>camera_depth/trigger</trigger_topic>
		</camera>
		<always_on>true</always_on>
		<update_rate>10.0</update_rate>
		<topic>camera_depth</topic>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

<gazebo reference="l_cam001">
	<sensor type="boundingbox_camera" name="boundingbox_camera_full_2d">
		<topic>camera_boxes_full_2d</topic>
		<camera>
			<box_type>full_2d</box_type>
			<horizontal_fov>1.047</horizontal_fov>
			<image>
				<width>800</width>
				<height>600</height>
			</image>
			<clip>
				<near>0.1</near>
				<far>10.0</far>
			</clip>
			<save enabled="false">
				<path>/tmp/camera_boxes_full_2d_data</path>
			</save>
			<triggered>false</triggered>
			<trigger_topic>camera_boxes_full_2d/trigger</trigger_topic>
		</camera>
		<always_on>true</always_on>
		<update_rate>30.0</update_rate>
		<visualize>true</visualize>
		<enable_metrics>true</enable_metrics>
	</sensor>
</gazebo>

</robot>
